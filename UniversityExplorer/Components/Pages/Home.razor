@page "/"
@rendermode InteractiveServer

<PageTitle>Home - University Explorer Portal</PageTitle>

<section class="hero mb-5">
    <div class="hero-content">
        <div class="eyebrow hero-eyebrow mb-2">Find your next university</div>
        <h1 class="hero-title mb-3">University Explorer Portal</h1>
        <p class="hero-lead mb-0">
            Explore universities around the world and manage your university applications in one place.
        </p>
    </div>
    <i class="bi bi-mortarboard-fill hero-decoration" aria-hidden="true"></i>
</section>

<div class="row g-4">
    <div class="col-12 col-md-4">
        <div class="card h-100 shadow-sm card-hover">
            <div class="card-body p-4">
                <div class="icon-badge mb-3" aria-hidden="true"><i class="bi bi-globe-americas"></i></div>
                <h2 class="h5">University Explorer</h2>
                <p class="text-muted">
                    Select a country to see its details, then browse, search and inspect its universities.
                </p>
                <a href="university-explorer" class="stretched-link fw-semibold text-decoration-none">
                    Explore universities <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i>
                </a>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-4">
        <div class="card h-100 shadow-sm card-hover">
            <div class="card-body p-4">
                <div class="icon-badge mb-3" aria-hidden="true"><i class="bi bi-card-list"></i></div>
                <h2 class="h5">Student Applications</h2>
                <p class="text-muted">
                    View all submitted applications and edit or delete existing ones.
                </p>
                <a href="student-applications" class="stretched-link fw-semibold text-decoration-none">
                    View applications <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i>
                </a>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-4">
        <div class="card h-100 shadow-sm card-hover">
            <div class="card-body p-4">
                <div class="icon-badge mb-3" aria-hidden="true"><i class="bi bi-plus-square"></i></div>
                <h2 class="h5">New Application</h2>
                <p class="text-muted">
                    Apply to a university programme by submitting a new application.
                </p>
                <a href="student-applications/create" class="stretched-link fw-semibold text-decoration-none">
                    Create application <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i>
                </a>
            </div>
        </div>
    </div>
</div>

<section class="mt-5">
    <h2 class="h4 mb-3">Statistics</h2>
    <StatisticsOverview />
</section>

<section class="mt-5">
    <div class="eyebrow text-muted mb-2">Powered by</div>
    <div class="d-flex flex-wrap gap-2">
        <span class="source-chip">
            <i class="bi bi-flag" aria-hidden="true"></i>
            <strong>Countries API</strong> · countries.dev
        </span>
        <span class="source-chip">
            <i class="bi bi-building" aria-hidden="true"></i>
            <strong>Universities API</strong> · Hipolabs
        </span>
        <span class="source-chip">
            <i class="bi bi-file-earmark-text" aria-hidden="true"></i>
            <strong>Student Application API</strong> · Edutots
        </span>
    </div>
</section>