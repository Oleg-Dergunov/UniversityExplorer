@page "/university-explorer"
@rendermode InteractiveServer
@inject ICountryService CountryService
@inject IUniversityService UniversityService
@inject IFavouritesService FavouritesService
@inject ILocalStorageService LocalStorage
@inject IJSRuntime JS
@inject ILogger<UniversityExplorerPage> Logger

<PageTitle>University Explorer</PageTitle>

<PageHeader Title="University Explorer"
            Subtitle="Choose a country to see its details and browse its universities."
            Icon="bi-globe-americas" />

@if (isLoadingCountries)
{
    <LoadingIndicator Message="Loading countries..." />
}
else if (hasCountryError)
{
    <ErrorAlert Message="Unable to retrieve countries. Please try again later."
                OnRetry="LoadCountriesAsync" />
}
else
{
    <div class="row g-4">
        <div class="col-12 col-lg-4">
            <div class="explorer-sidebar">
                <CountrySelector Countries="countries"
                                 SelectedCountryName="@selectedCountry?.Name"
                                 OnCountrySelected="HandleCountrySelectedAsync" />

                @if (selectedCountry is not null)
                {
                    <div class="mt-4">
                        <CountryDetails Country="selectedCountry" />
                    </div>
                }
            </div>
        </div>

        <div class="col-12 col-lg-8">
            @if (selectedCountry is null)
            {
                <EmptyState Icon="bi-globe-americas" Title="No country selected">
                    Choose a country from the list to see its universities.
                </EmptyState>
            }
            else if (isLoadingUniversities)
            {
                <LoadingIndicator Message="@($"Loading universities in {selectedCountry.Name}...")" />
            }
            else if (hasUniversityError)
            {
                <ErrorAlert Message="Unable to retrieve universities. Please try again later."
                            OnRetry="LoadUniversitiesAsync" />
            }
            else if (universities.Count == 0)
            {
                <EmptyState Icon="bi-building" Title="@($"No universities found for {selectedCountry.Name}")">
                    The Universities API has no records for this country.
                </EmptyState>
            }
            else
            {
                var filtered = FilteredUniversities.ToList();
                var favouritesCount = universities.Count(FavouritesService.IsFavourite);
                var totalPages = Math.Max(1, (int)Math.Ceiling(filtered.Count / (double)PageSize));
                var visiblePage = Math.Min(currentPage, totalPages);
                var pageItems = filtered.Skip((visiblePage - 1) * PageSize).Take(PageSize).ToList();

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="h5 mb-0">Universities in @selectedCountry.Name</h2>
                    <span class="badge badge-soft rounded-pill">@filtered.Count of @universities.Count</span>
                </div>

                <div class="d-flex gap-2 mb-3">
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-search" aria-hidden="true"></i></span>
                        <input class="form-control"
                               @bind="searchText"
                               @bind:event="oninput"
                               @bind:after="ResetPage"
                               placeholder="Search university..."
                               aria-label="Search university" />
                    </div>

                    <button type="button"
                            class="btn @(showFavouritesOnly ? "btn-primary" : "btn-outline-secondary favourites-filter") text-nowrap"
                            title="@(showFavouritesOnly ? "Showing favourites only. Click to show all" : "Show favourites only")"
                            aria-pressed="@showFavouritesOnly.ToString().ToLowerInvariant()"
                            @onclick="ToggleFavouritesFilterAsync">
                        <i class="bi @(showFavouritesOnly ? "bi-star-fill" : "bi-star") me-1" aria-hidden="true"></i>@favouritesCount
                    </button>

                    <button type="button" class="btn btn-outline-secondary text-nowrap"
                            title="@(sortAscending ? "Sorted A to Z. Click to sort Z to A" : "Sorted Z to A. Click to sort A to Z")"
                            @onclick="ToggleSortOrderAsync">
                        @(sortAscending ? "A–Z" : "Z–A")
                    </button>
                </div>

                @if (filtered.Count == 0)
                {
                    @if (showFavouritesOnly && string.IsNullOrWhiteSpace(searchText))
                    {
                        <EmptyState Icon="bi-star" Title="@($"No favourites in {selectedCountry.Name} yet")">
                            Click the star on a university to add it to your favourites.
                        </EmptyState>
                    }
                    else
                    {
                        <EmptyState Icon="bi-search" Title="No matching universities">
                            Nothing matches "@searchText". Try a different search.
                        </EmptyState>
                    }
                }
                else
                {
                    <div class="row row-cols-1 row-cols-md-2 g-3">
                        @foreach (var university in pageItems)
                        {
                            <div class="col" @key="university.Name">
                                <UniversityCard University="university"
                                                IsSelected="university == selectedUniversity"
                                                IsFavourite="FavouritesService.IsFavourite(university)"
                                                OnSelect="HandleUniversitySelected"
                                                OnToggleFavourite="HandleToggleFavouriteAsync" />
                            </div>
                        }
                    </div>

                    @if (totalPages > 1)
                    {
                        <div class="mt-4">
                            <Pagination CurrentPage="visiblePage"
                                        TotalPages="totalPages"
                                        OnPageChanged="HandlePageChangedAsync" />
                            <p class="text-muted small text-center mt-2 mb-0">
                                Showing @((visiblePage - 1) * PageSize + 1)–@((visiblePage - 1) * PageSize + pageItems.Count)
                                of @filtered.Count
                            </p>
                        </div>
                    }
                }
            }
        </div>
    </div>
}

@if (selectedUniversity is not null)
{
    <UniversityDetails University="selectedUniversity"
                       Country="selectedCountry"
                       IsFavourite="FavouritesService.IsFavourite(selectedUniversity)"
                       OnToggleFavourite="HandleToggleFavouriteAsync"
                       OnClose="CloseUniversityDetails" />
}

@code {
    private const int PageSize = 20;
    private const string PreferencesKey = "universityExplorer.explorerPreferences";

    private List<Country> countries = new();
    private Country? selectedCountry;
    private string? pendingCountryName;

    private List<University> universities = new();
    private University? selectedUniversity;
    private string searchText = string.Empty;
    private bool sortAscending = true;
    private bool showFavouritesOnly;
    private int currentPage = 1;

    private bool isLoadingCountries = true;
    private bool hasCountryError;

    private bool isLoadingUniversities;
    private bool hasUniversityError;

    private IEnumerable<University> FilteredUniversities
    {
        get
        {
            IEnumerable<University> result = universities;

            if (showFavouritesOnly)
            {
                result = result.Where(FavouritesService.IsFavourite);
            }

            if (!string.IsNullOrWhiteSpace(searchText))
            {
                result = result.Where(u => u.Name.Contains(searchText.Trim(), StringComparison.OrdinalIgnoreCase));
            }

            return sortAscending
                ? result.OrderBy(u => u.Name)
                : result.OrderByDescending(u => u.Name);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadCountriesAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // localStorage is only reachable once the page is interactive
        if (!firstRender)
        {
            return;
        }

        await FavouritesService.EnsureLoadedAsync();

        var preferences = await LocalStorage.GetAsync<ExplorerPreferences>(PreferencesKey);

        if (preferences is not null)
        {
            sortAscending = preferences.SortAscending;
            showFavouritesOnly = preferences.ShowFavouritesOnly;
            pendingCountryName = preferences.CountryName;
        }

        StateHasChanged();
        await TryRestoreCountryAsync();
    }

    private async Task LoadCountriesAsync()
    {
        isLoadingCountries = true;
        hasCountryError = false;

        try
        {
            countries = await CountryService.GetAllCountriesAsync();
        }
        catch (Exception ex)
        {
            hasCountryError = true;
            Logger.LogError(ex, "Failed to load countries");
        }
        finally
        {
            isLoadingCountries = false;
        }

        await TryRestoreCountryAsync();
    }

    // Preferences and countries load independently, so this runs after each of them;
    // the country is restored once both are available
    private async Task TryRestoreCountryAsync()
    {
        if (pendingCountryName is null || countries.Count == 0 || selectedCountry is not null)
        {
            return;
        }

        var country = countries.FirstOrDefault(c => c.Name == pendingCountryName);
        pendingCountryName = null;

        if (country is null)
        {
            return;
        }

        selectedCountry = country;
        currentPage = 1;
        StateHasChanged();

        await LoadUniversitiesAsync();
        StateHasChanged();
    }

    private async Task HandleCountrySelectedAsync(Country country)
    {
        selectedCountry = country;
        selectedUniversity = null;
        searchText = string.Empty;
        currentPage = 1;

        await SavePreferencesAsync();
        await LoadUniversitiesAsync();
    }

    private async Task LoadUniversitiesAsync()
    {
        if (selectedCountry is null)
        {
            return;
        }

        var requestedCountry = selectedCountry;

        isLoadingUniversities = true;
        hasUniversityError = false;
        universities = new();

        try
        {
            var result = await UniversityService.GetUniversitiesByCountryAsync(requestedCountry.Name);

            // Ignore stale responses if the user switched country while this request was running
            if (requestedCountry != selectedCountry)
            {
                return;
            }

            universities = result;
        }
        catch (Exception ex)
        {
            if (requestedCountry != selectedCountry)
            {
                return;
            }

            hasUniversityError = true;
            Logger.LogError(ex, "Failed to load universities for {Country}", requestedCountry.Name);
        }
        finally
        {
            if (requestedCountry == selectedCountry)
            {
                isLoadingUniversities = false;
            }
        }
    }

    private Task SavePreferencesAsync() =>
        LocalStorage.SetAsync(PreferencesKey, new ExplorerPreferences
        {
            CountryName = selectedCountry?.Name,
            SortAscending = sortAscending,
            ShowFavouritesOnly = showFavouritesOnly
        });

    private void ResetPage()
    {
        currentPage = 1;
    }

    private async Task ToggleSortOrderAsync()
    {
        sortAscending = !sortAscending;
        currentPage = 1;
        await SavePreferencesAsync();
    }

    private async Task ToggleFavouritesFilterAsync()
    {
        showFavouritesOnly = !showFavouritesOnly;
        currentPage = 1;
        await SavePreferencesAsync();
    }

    private async Task HandlePageChangedAsync(int pageNumber)
    {
        currentPage = pageNumber;
        await JS.InvokeVoidAsync("scrollTo", new { top = 0, behavior = "smooth" });
    }

    private async Task HandleToggleFavouriteAsync(University university)
    {
        await FavouritesService.ToggleAsync(university);
    }

    private void HandleUniversitySelected(University university)
    {
        selectedUniversity = university;
    }

    private void CloseUniversityDetails()
    {
        selectedUniversity = null;
    }
}