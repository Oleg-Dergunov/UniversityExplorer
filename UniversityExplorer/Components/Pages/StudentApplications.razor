@page "/student-applications"
@rendermode InteractiveServer
@inject IStudentApplicationService ApplicationService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ILogger<StudentApplications> Logger

<PageTitle>Student Applications</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <h1 class="mb-0">
        Student Applications
        @if (!isLoading && !hasError)
        {
            <span class="badge text-bg-secondary fs-6 align-middle">@applications.Count</span>
        }
    </h1>
    <a href="student-applications/create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>New application
    </a>
</div>

@if (showUpdatedMessage && UpdatedId is not null)
{
    <div class="alert alert-success d-flex align-items-center justify-content-between gap-3" role="alert">
        <span>
            <i class="bi bi-check-circle-fill me-2" aria-hidden="true"></i>
            Application #@UpdatedId was updated successfully.
        </span>
        <button type="button" class="btn-close" aria-label="Close"
                @onclick="() => showUpdatedMessage = false"></button>
    </div>
}

@if (isLoading)
{
    <LoadingIndicator Message="Loading student applications..." />
}
else if (hasError)
{
    <ErrorAlert Message="Unable to retrieve student applications. Please try again later."
                OnRetry="LoadApplicationsAsync" />
}
else if (applications.Count == 0)
{
    <div class="alert alert-info">
        No applications have been submitted yet.
        <a href="student-applications/create" class="alert-link">Create the first one</a>.
    </div>
}
else
{
    var totalPages = (int)Math.Ceiling(applications.Count / (double)PageSize);
    var visiblePage = Math.Clamp(currentPage, 1, totalPages);
    var pageItems = applications.Skip((visiblePage - 1) * PageSize).Take(PageSize).ToList();

    <StudentApplicationList Applications="pageItems"
                            HighlightedId="UpdatedId"
                            OnEdit="HandleEdit" />

    @if (totalPages > 1)
    {
        <div class="mt-3">
            <Pagination CurrentPage="visiblePage"
                        TotalPages="totalPages"
                        OnPageChanged="HandlePageChangedAsync" />
            <p class="text-muted small text-center mt-2 mb-0">
                Showing @((visiblePage - 1) * PageSize + 1)–@((visiblePage - 1) * PageSize + pageItems.Count)
                of @applications.Count
            </p>
        </div>
    }
}

@code {
    private const int PageSize = 10;

    [SupplyParameterFromQuery(Name = "updated")]
    public int? UpdatedId { get; set; }

    private List<StudentApplication> applications = new();
    private int currentPage = 1;

    private bool isLoading = true;
    private bool hasError;
    private bool showUpdatedMessage = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadApplicationsAsync();
    }

    private async Task LoadApplicationsAsync()
    {
        isLoading = true;
        hasError = false;

        try
        {
            applications = await ApplicationService.GetAllAsync();
            currentPage = GetInitialPage();
        }
        catch (Exception ex)
        {
            hasError = true;
            Logger.LogError(ex, "Failed to load student applications");
        }
        finally
        {
            isLoading = false;
        }
    }

    // After an update, open the page that contains the updated application so its highlight is visible
    private int GetInitialPage()
    {
        if (UpdatedId is null)
        {
            return 1;
        }

        var index = applications.FindIndex(a => a.Id == UpdatedId);
        return index < 0 ? 1 : index / PageSize + 1;
    }

    private async Task HandlePageChangedAsync(int pageNumber)
    {
        currentPage = pageNumber;
        await JS.InvokeVoidAsync("scrollTo", new { top = 0, behavior = "smooth" });
    }

    private void HandleEdit(StudentApplication application)
    {
        Navigation.NavigateTo($"student-applications/edit/{application.Id}");
    }
}