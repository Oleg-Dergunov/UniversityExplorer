@page "/student-applications"
@rendermode InteractiveServer
@inject IStudentApplicationService ApplicationService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ILogger<StudentApplications> Logger

<PageTitle>Student Applications</PageTitle>

<PageHeader Title="Student Applications"
            Subtitle="View, edit and delete university applications."
            Icon="bi-card-list">
    @if (!isLoading && !hasError)
    {
        <span class="badge badge-soft rounded-pill fs-6 align-self-center">@applications.Count total</span>
    }
    <a href="student-applications/create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>New application
    </a>
</PageHeader>

@if (successMessage is not null)
{
    <div class="alert alert-success d-flex align-items-center justify-content-between gap-3" role="alert">
        <span>
            <i class="bi bi-check-circle-fill me-2" aria-hidden="true"></i>@successMessage
        </span>
        <button type="button" class="btn-close" aria-label="Close"
                @onclick="() => successMessage = null"></button>
    </div>
}

@if (deleteErrorMessage is not null)
{
    <ErrorAlert Message="@deleteErrorMessage" />
}

@if (isLoading)
{
    <LoadingIndicator Message="Loading student applications..." />
}
else if (hasError)
{
    <ErrorAlert Message="Unable to retrieve student applications. Please try again later."
                OnRetry="LoadApplicationsAsync" />
}
else if (applications.Count == 0)
{
    <EmptyState Icon="bi-card-list" Title="No applications yet">
        <a href="student-applications/create">Create the first application</a> to see it here.
    </EmptyState>
}
else
{
    var totalPages = (int)Math.Ceiling(applications.Count / (double)PageSize);
    var visiblePage = Math.Clamp(currentPage, 1, totalPages);
    var pageItems = applications.Skip((visiblePage - 1) * PageSize).Take(PageSize).ToList();

    <StudentApplicationList Applications="pageItems"
                            HighlightedId="UpdatedId"
                            OnEdit="HandleEdit"
                            OnDelete="RequestDelete" />

    @if (totalPages > 1)
    {
        <div class="mt-4">
            <Pagination CurrentPage="visiblePage"
                        TotalPages="totalPages"
                        OnPageChanged="HandlePageChangedAsync" />
            <p class="text-muted small text-center mt-2 mb-0">
                Showing @((visiblePage - 1) * PageSize + 1)–@((visiblePage - 1) * PageSize + pageItems.Count)
                of @applications.Count
            </p>
        </div>
    }
}

@if (applicationToDelete is not null)
{
    <ConfirmDialog Title="Delete application"
                   ConfirmText="Delete"
                   IsProcessing="isDeleting"
                   OnConfirm="ConfirmDeleteAsync"
                   OnCancel="CancelDelete">
        <p class="mb-2">
            Are you sure you want to delete application <strong>#@applicationToDelete.Id</strong>?
        </p>
        <p class="text-muted mb-0">
            @applicationToDelete.StudentName — @applicationToDelete.UniversityName
        </p>
        <p class="text-danger small mt-3 mb-0">
            <i class="bi bi-exclamation-triangle me-1" aria-hidden="true"></i>This action cannot be undone.
        </p>
    </ConfirmDialog>
}

@code {
    private const int PageSize = 10;

    [SupplyParameterFromQuery(Name = "updated")]
    public int? UpdatedId { get; set; }

    private List<StudentApplication> applications = new();
    private int currentPage = 1;

    private bool isLoading = true;
    private bool hasError;

    private StudentApplication? applicationToDelete;
    private bool isDeleting;

    private string? successMessage;
    private string? deleteErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        if (UpdatedId is not null)
        {
            successMessage = $"Application #{UpdatedId} was updated successfully.";
        }

        await LoadApplicationsAsync();
    }

    private async Task LoadApplicationsAsync()
    {
        isLoading = true;
        hasError = false;

        try
        {
            applications = await ApplicationService.GetAllAsync();
            currentPage = GetInitialPage();
        }
        catch (Exception ex)
        {
            hasError = true;
            Logger.LogError(ex, "Failed to load student applications");
        }
        finally
        {
            isLoading = false;
        }
    }

    // After an update, open the page that contains the updated application so its highlight is visible
    private int GetInitialPage()
    {
        if (UpdatedId is null)
        {
            return 1;
        }

        var index = applications.FindIndex(a => a.Id == UpdatedId);
        return index < 0 ? 1 : index / PageSize + 1;
    }

    private async Task HandlePageChangedAsync(int pageNumber)
    {
        currentPage = pageNumber;
        await JS.InvokeVoidAsync("scrollTo", new { top = 0, behavior = "smooth" });
    }

    private void HandleEdit(StudentApplication application)
    {
        Navigation.NavigateTo($"student-applications/edit/{application.Id}");
    }

    private void RequestDelete(StudentApplication application)
    {
        applicationToDelete = application;
        deleteErrorMessage = null;
    }

    private void CancelDelete()
    {
        applicationToDelete = null;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (applicationToDelete is null)
        {
            return;
        }

        var target = applicationToDelete;
        isDeleting = true;

        try
        {
            await ApplicationService.DeleteAsync(target.Id);

            applications.Remove(target);
            successMessage = $"Application #{target.Id} ({target.StudentName}) was deleted.";
        }
        catch (Exception ex)
        {
            deleteErrorMessage = $"Unable to delete application #{target.Id}. Please try again.";
            Logger.LogError(ex, "Failed to delete student application {Id}", target.Id);
        }
        finally
        {
            isDeleting = false;
            applicationToDelete = null;
        }
    }
}