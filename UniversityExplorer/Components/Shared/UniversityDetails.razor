<div class="modal fade show d-block" tabindex="-1" role="dialog"
     aria-modal="true" aria-labelledby="university-details-title"
     @ref="modalElement"
     @onclick="CloseAsync"
     @onkeydown="HandleKeyDownAsync">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable"
         @onclick:stopPropagation="true">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <small class="text-muted text-uppercase">University Details</small>
                    <h2 class="modal-title h5 mb-0" id="university-details-title">@University.Name</h2>
                </div>
                <button type="button" class="btn-close" aria-label="Close" @onclick="CloseAsync"></button>
            </div>

            <div class="modal-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Name</dt>
                    <dd class="col-sm-8">@University.Name</dd>

                    <dt class="col-sm-4">Country</dt>
                    <dd class="col-sm-8">@University.Country</dd>

                    @if (!string.IsNullOrWhiteSpace(University.StateProvince))
                    {
                        <dt class="col-sm-4">State / Province</dt>
                        <dd class="col-sm-8">@University.StateProvince</dd>
                    }

                    <dt class="col-sm-4">Website</dt>
                    <dd class="col-sm-8">
                        @if (University.WebPages.Count == 0)
                        {
                            <span>N/A</span>
                        }
                        @foreach (var webPage in University.WebPages)
                        {
                            <a href="@webPage" target="_blank" rel="noopener noreferrer" class="d-block text-break">@webPage</a>
                        }
                    </dd>

                    <dt class="col-sm-4">Domain</dt>
                    <dd class="col-sm-8 mb-0 text-break">
                        @(University.Domains.Count == 0 ? "N/A" : string.Join(", ", University.Domains))
                    </dd>
                </dl>
            </div>

            <div class="modal-footer">
                @if (!string.IsNullOrWhiteSpace(University.Website))
                {
                    <a href="@University.Website" target="_blank" rel="noopener noreferrer" class="btn btn-primary">
                        <i class="bi bi-box-arrow-up-right me-1" aria-hidden="true"></i>Visit website
                    </a>
                }
                <button type="button" class="btn btn-outline-secondary" @onclick="CloseAsync">Close</button>
            </div>
        </div>
    </div>
</div>
<div class="modal-backdrop fade show"></div>

@code {
    private ElementReference modalElement;

    [Parameter, EditorRequired]
    public University University { get; set; } = default!;

    [Parameter]
    public EventCallback OnClose { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Focus the modal so that the Escape key works immediately
        if (firstRender)
        {
            await modalElement.FocusAsync();
        }
    }

    private Task CloseAsync() => OnClose.InvokeAsync();

    private async Task HandleKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await CloseAsync();
        }
    }
}