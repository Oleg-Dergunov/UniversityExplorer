<div class="card h-100 shadow-sm card-hover @(IsSelected ? "is-selected" : null)">
    <div class="card-body d-flex flex-column p-3">
        <div class="d-flex align-items-start gap-3">
            <div class="flex-grow-1 min-w-0">
                <h3 class="h6 mb-1">@University.Name</h3>
                <div class="text-muted small">
                    <i class="bi bi-geo-alt me-1" aria-hidden="true"></i>@University.Country
                </div>
            </div>

            @if (OnToggleFavourite.HasDelegate)
            {
                <button type="button" class="btn btn-link p-0 lh-1 favourite-toggle above-stretched"
                        title="@(IsFavourite ? "Remove from favourites" : "Add to favourites")"
                        aria-label="@(IsFavourite ? "Remove from favourites" : "Add to favourites")"
                        aria-pressed="@IsFavourite.ToString().ToLowerInvariant()"
                        @onclick="() => OnToggleFavourite.InvokeAsync(University)">
                    <i class="bi @(IsFavourite ? "bi-star-fill text-primary" : "bi-star text-secondary")" aria-hidden="true"></i>
                </button>
            }
        </div>

        <div class="mt-3 small">
            @if (!string.IsNullOrWhiteSpace(University.Website))
            {
                <a href="@University.Website" target="_blank" rel="noopener noreferrer"
                   class="above-stretched text-break">
                    <i class="bi bi-globe2 me-1" aria-hidden="true"></i>@University.WebsiteDisplay
                </a>
            }
            else
            {
                <span class="text-muted">No website available</span>
            }
        </div>

        <button type="button"
                class="btn btn-link p-0 mt-3 align-self-start fw-semibold text-decoration-none stretched-link"
                @onclick="() => OnSelect.InvokeAsync(University)">
            View details <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i>
        </button>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public University University { get; set; } = default!;

    [Parameter]
    public bool IsSelected { get; set; }

    [Parameter]
    public bool IsFavourite { get; set; }

    [Parameter]
    public EventCallback<University> OnSelect { get; set; }

    [Parameter]
    public EventCallback<University> OnToggleFavourite { get; set; }
}